# Application environment
APP_NAME=ThreatLens
APP_ENV=development
DEBUG=true

# Local SQLite database; PostgreSQL can be configured later for deployment.
DATABASE_URL=sqlite+aiosqlite:///./threatlens.db

# Optional services. Leave disabled for the simple local setup.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Generate a local secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME

# Provider keys are optional and must never be committed.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=
OTX_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Runtime limits
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_SCAN_CONCURRENCY=2
MAX_FILE_SIZE_MB=10
DEFAULT_SCAN_CACHE_TTL=3600
SESSION_TTL_HOURS=24
LOG_LEVEL=INFO
MOCK_PROVIDERS=true
